// LSS grammar (LALR)

%import common.WS
%import common.ESCAPED_STRING -> STRING
%ignore WS

COMMENT: /\/\/[^\n]*/
%ignore COMMENT

// Identifiers may contain hyphens between word parts, like CSS: "by-size", "blue-grey"
NAME: /[a-zA-Z_][a-zA-Z0-9_]*(-[a-zA-Z_][a-zA-Z0-9_]*)*/
VARIABLE: /@[a-zA-Z_][a-zA-Z0-9_]*(-[a-zA-Z0-9_]+)*/
CONFIG_REF: /\$[a-zA-Z_][a-zA-Z0-9_]*/
COLOR: /#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})\b/
DP.2: /\d+dp\b/
PERCENT.2: /\d+%/
NUMBER: /\d+(\.\d+)?/

start: entry*

?entry: theme_decl
      | config_decl
      | variable_decl
      | transition_decl
      | style_decl
      | apply_decl
      | widget_decl
      | cif_entries

theme_decl: "@theme" NAME ";"

// A widget class that isn't part of LVGL: @widget <type>: <class symbol>;
widget_decl: "@widget" NAME ":" NAME ";"

config_decl: "@config" "{" config_field* "}"
config_field: NAME ":" NAME ["=" expr] ";"

variable_decl: VARIABLE ":" expr ";"

transition_decl: "@transition" NAME "{" property* "}"

cif_entries: "@cif" "(" NAME ")" "{" entry* "}"

// Styles

style_decl: NAME "{" style_item* "}"
?style_item: property | style_if | style_cif
property: NAME ":" expr ("," expr)* ";"
style_if: "@if" "(" expr ")" "{" style_item* "}" [style_else]
style_else: "@else" "{" style_item* "}"
style_cif: "@cif" "(" NAME ")" "{" style_item* "}"

// Apply rules

apply_decl: "apply" "(" selector ("," selector)* ")" "{" apply_item* "}"
selector: compound (">" compound)*
?compound: NAME ["[" NUMBER "]"]            -> compound_named
         | "*" ["[" NUMBER "]"]             -> compound_any

?apply_item: apply_style | apply_include | apply_if | apply_cif
apply_style: NAME ":" target ("," target)* ";"
target: NAME ["." NAME]
apply_include: "@include" selector ";"
apply_if: "@if" "(" expr ")" "{" apply_item* "}" [apply_else]
apply_else: "@else" "{" apply_item* "}"
apply_cif: "@cif" "(" NAME ")" "{" apply_item* "}"

// Expressions

?expr: or_expr
?or_expr: and_expr
        | or_expr "||" and_expr              -> or_op
?and_expr: cmp_expr
         | and_expr "&&" cmp_expr            -> and_op
?cmp_expr: bitor_expr
         | bitor_expr "==" bitor_expr        -> eq
         | bitor_expr "!=" bitor_expr        -> ne
?bitor_expr: sum
           | bitor_expr "|" sum              -> bitor
?sum: product
    | sum "+" product                        -> add
    | sum "-" product                        -> sub
?product: unary
        | product "*" unary                  -> mul
        | product "/" unary                  -> div
?unary: "-" unary                            -> neg
      | "!" unary                            -> not_op
      | atom
?atom: DP                                    -> dp
     | PERCENT                               -> percent
     | NUMBER                                -> number
     | COLOR                                 -> color
     | VARIABLE                              -> var_ref
     | CONFIG_REF                            -> config_ref
     | STRING                                -> string
     | NAME "(" [expr ("," expr)*] ")"       -> call
     | NAME                                  -> ident
     | "(" expr ")"
