@theme transitions;

@transition normal {
    props: bgOpa, bgColor, transformScaleX;
    duration: 200;
}

@transition delayed {
    props: bgOpa;
    path: ease-out;
    duration: 200;
    delay: 70;
}

transition_normal {
    transition: normal;
}

transition_delayed {
    transition: delayed;
}

apply(button) {
    transition_delayed: default;
    transition_normal: state.pressed;
}
